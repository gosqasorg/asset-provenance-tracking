{
  "version": "2.0",
  "logging": {
    "fileLoggingMode": "debugOnly",
    "console": {
      "isEnabled": true
    },
    "logLevel": {
      "default": "Trace",
      "Host.Aggregator": "Error",
      "Host.Results": "Error",
      "Function": "Trace",
      "Host.Function.Console": "Trace"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond" : 20
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  }
}
